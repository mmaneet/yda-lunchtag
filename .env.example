# Copy to .env for local overrides. Real values live in Railway environment
# variables — never commit them.

# Directory holding the SQLite database file (default: ./data)
LUNCHTAG_DATA_DIR=

# Flask session secret. Any long random string. Required in production.
FLASK_SECRET_KEY=

# Postgres connection string. When set, the app uses Postgres instead of SQLite.
# On Railway this is a reference to the Postgres plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
