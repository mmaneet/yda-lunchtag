# Copy to .env for local overrides. Real values live in Railway environment
# variables — never commit them.

# Directory holding the SQLite database file (default: ./data)
LUNCHTAG_DATA_DIR=

# Flask session secret. Any long random string. Required in production.
FLASK_SECRET_KEY=

# Postgres connection string. When set, the app uses Postgres instead of SQLite.
# On Railway this is a reference to the Postgres plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Google OAuth sign-in (optional). Leave both empty to run with auth disabled
# (no login required — how local dev works today). To enable login, create an
# OAuth 2.0 Client ID (type: Web application) in Google Cloud Console and put
# its credentials here / in Railway env vars. See README "Auth" for the
# redirect URIs to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TESTING ONLY. When set, the login page shows a "dummy login" button that
# signs in as this email with no OAuth and no yale.edu check — anyone who can
# reach the site can use it. Unset to remove the button. Never set this once
# real member data is loaded.
DUMMY_LOGIN_EMAIL=
